NODE_ENV=development
PORT=3001
POSTGRES_PASSWORD=replace-local-compose-database-password
DATABASE_URL=postgres://research:replace-local-compose-database-password@127.0.0.1:5432/research
CODE_PEPPER=replace-with-at-least-32-random-bytes
DEV_ACCESS_CODE=TRUST-DEMO-2026
DEV_ADMIN_TOKEN=replace-development-admin-token
# Production: put the admin route behind an institutional OIDC proxy.
OIDC_PROXY_SECRET=replace-shared-proxy-secret
# Set only after the ethics-approved consent-de-v2 text has replaced the placeholder.
CONSENT_RELEASED=false
DB_SSL=false
# Exact comma-separated origins allowed to call the hosted study API.
# Keep empty for the same-origin portal; set staging/production origins only.
STUDY_ALLOWED_ORIGINS=
# Firebase Storage is accessed only by the API service account (Cloud Run ADC).
# Never put service-account JSON or this bucket's credentials in the browser bundle.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Public build-time API endpoint for GitHub Pages (not a secret).
VITE_API_ORIGIN=
# Firebase Web App config is public client configuration; Storage access remains
# server-only and must never be granted to anonymous browser users.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=
# Optional: comma-separated individual researcher emails allowed to use named
# admin accounts. Password hashes and TOTP secrets belong in Secret Manager.
RESEARCHER_ACCOUNT_EMAILS=
# Optional local admin feature: keep trustee norming/outcome-bank controls hidden
# until they are needed.
VITE_ENABLE_NORMING_ADMIN=false
