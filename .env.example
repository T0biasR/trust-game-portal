NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Local app testing MUST use the emulator project ID so no test records reach
# the real trust-gamev1 Firebase project.
FIREBASE_PROJECT_ID=demo-trust-gamev1
# Firebase Emulator address; set this in the environment when running locally.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Auth emulator address; the server verifies anonymous participant ID tokens.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# On hroot, prefer ADC / federation. If a service-account-key fallback is approved,
# keep its file outside this project and set its absolute path here.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/grace26-firestore-identity.json
CODE_PEPPER=replace-with-at-least-32-random-bytes
DEV_ACCESS_CODE=TRUST-DEMO-2026
DEV_ADMIN_TOKEN=replace-development-admin-token
# Production: Apache must enforce University SSO on /grace26/admin and
# /grace26/api/admin/*, strip untrusted copies of these headers, then inject
# them itself. Never accept browser-supplied identity headers directly.
OIDC_PROXY_SECRET=replace-shared-proxy-secret
# Set only after the ethics-approved consent-de-v2 text has replaced the placeholder.
CONSENT_RELEASED=false
# Exact comma-separated origins allowed to call the hosted study API.
# Keep empty for the same-origin portal; set staging/production origins only.
STUDY_ALLOWED_ORIGINS=
# Build-time URL for the same-origin server API. This is public, not a secret.
VITE_API_ORIGIN=
# Public Firebase Web App settings from Firebase Console → Project settings → Your apps.
# These are browser configuration values, not service-account credentials.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-trust-gamev1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-trust-gamev1
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
# Local emulator URLs; set both to blank when building for the live Firebase project.
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_URL=http://127.0.0.1:8080
# Vite build base path for this University-hosted deployment.
VITE_BASE_PATH=/
# Optional local admin feature: keep trustee norming/outcome-bank controls hidden
# until they are needed.
VITE_ENABLE_NORMING_ADMIN=false
