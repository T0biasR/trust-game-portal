{
  "name": "online-task-paradigms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/firestoreIndex.ts",
    "build": "npm run typecheck && vite build",
    "build:spp": "npm run typecheck && vite build",
    "build:github-pages": "npm run typecheck && vite build --mode github-pages",
    "build:server": "tsc -p server/tsconfig.json",
    "build:functions": "npm run build:server && node scripts/package-functions.mjs",
    "build:functions": "npm run build:server && node scripts/package-functions.mjs",
    "test:firestore-connection": "node scripts/firestore-smoke.mjs",
    "emulator": "npx --yes firebase-tools@15.32.1 emulators:start --only auth,firestore --project demo-trust-gamev1",
    "emulator:functions": "npm run build:functions && npx --yes firebase-tools@15.32.1 emulators:start --only auth,firestore,functions --project demo-trust-gamev1",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server-dist/server/firestoreIndex.js",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts && python3 -m unittest discover -s modeling -p 'test_*.py' -v",
    "test:api": "node tests/api-smoke.mjs",
    "test:firestore-rules": "node scripts/firestore-rules-smoke.mjs",
    "test:production-gates": "node tests/production-gates.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jspsych": "^8.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
