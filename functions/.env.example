# Local Functions emulator only. Use a demo project ID so tests cannot touch
# the real Firebase project. Copy to .env.demo-trust-gamev1 locally.
STUDY_FIREBASE_PROJECT_ID=demo-trust-gamev1
STUDY_ALLOWED_ORIGINS=http://localhost:5173
CONSENT_RELEASED=true
REQUIRE_APP_CHECK=false
RESEARCHER_ACCOUNT_EMAILS=researcher@example.org
FUNCTION_SERVICE_ACCOUNT=local-emulator@demo.invalid
